<Page x:Class="CleanMachine.Windows.StartupAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE7E8;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Startup Applications" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Manage which programs start automatically when you sign in. Disabling an entry keeps it installed but prevents it from launching."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Summary bar -->
    <Border Grid.Row="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16,12">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="#4B7769" VerticalAlignment="Center"/>
            <TextBlock x:Name="TotalCount" Text="0 entries" FontSize="13" FontWeight="SemiBold"
                       Foreground="#273630" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#286E58" VerticalAlignment="Center"/>
            <TextBlock x:Name="EnabledCount" Text="0 enabled" FontSize="13"
                       Foreground="#6E8178" VerticalAlignment="Center"/>
          </StackPanel>
          <!-- Orphaned-entry warning: shown (icon + text together) only when there are
               orphans, so the error icon never appears on a clean startup list. -->
          <StackPanel x:Name="OrphanBadge" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="#C7775D" VerticalAlignment="Center"/>
            <TextBlock x:Name="OrphanCount" Text="0 orphaned" FontSize="13"
                       Foreground="#C7775D" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Sort" FontSize="12" Foreground="#6E8178" VerticalAlignment="Center"/>
          <ComboBox x:Name="SortBox" MinWidth="150" VerticalAlignment="Center"
                    SelectionChanged="SortBox_SelectionChanged"
                    ToolTipService.ToolTip="Choose how the startup entries are ordered">
            <ComboBoxItem Content="Location" IsSelected="True"/>
            <ComboBoxItem Content="Name (A–Z)"/>
            <ComboBoxItem Content="Status (enabled first)"/>
          </ComboBox>
        </StackPanel>
        <Button Grid.Column="3" Content="Scan" x:Name="ScanButton" Click="Scan_Click"
                Background="#286E58" Foreground="White" Padding="20,8"/>
      </Grid>
    </Border>

    <!-- Entry list -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="ListLabel" Text="STARTUP ENTRIES" FontSize="10"
                   Foreground="#7F9189" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="EntryPanel" Spacing="0"/>
        </ScrollViewer>
        <!-- Placeholder when empty -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Visibility="Visible">
          <FontIcon Glyph="&#xE7E8;" FontSize="32" Foreground="#D0DBD5" HorizontalAlignment="Center"/>
          <TextBlock Text="Click Scan to discover startup entries"
                     FontSize="13" Foreground="#9AA6A1" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
