<Page x:Class="CleanMachine.Windows.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <TextBlock Text="Updates" FontSize="30" FontWeight="SemiBold" Foreground="#273630"/>
    <TextBlock Text="Packages are selected by architecture, verified by SHA-256, and checked for publisher identity before installation."
               Foreground="#89958F" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click"
              Background="#286E58" Foreground="White" Padding="18,10"/>
      <Button x:Name="InstallButton" Content="Install verified package" Click="Install_Click"
              Visibility="Collapsed" Background="#286E58" Foreground="White" Padding="18,10"/>
      <Button x:Name="RollbackButton" Content="Rollback to previous version" Click="Rollback_Click"
              Visibility="Collapsed" Padding="18,10"/>
    </StackPanel>

    <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed"/>

    <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="18">
      <StackPanel Spacing="8">
        <TextBlock x:Name="StatusText" Text="No update check performed yet."
                   Foreground="#6E8178" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText" Foreground="#89958F" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="PendingText" Foreground="#C7775D" TextWrapping="Wrap"
               Visibility="Collapsed"/>
  </StackPanel>
</Page>
