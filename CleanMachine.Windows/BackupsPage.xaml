<Page x:Class="CleanMachine.Windows.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE777;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Registry Backups" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Restore points created automatically before each registry clean. Restore merges a backup back into your user registry, or delete backups you no longer need."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Summary bar -->
    <Border Grid.Row="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#4B7769" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="0 backups" FontSize="13" FontWeight="SemiBold"
                       Foreground="#273630" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="#286E58" VerticalAlignment="Center"/>
            <TextBlock x:Name="SizeText" Text="0 B total" FontSize="13"
                       Foreground="#6E8178" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="Open Folder" x:Name="OpenFolderButton" Click="OpenFolder_Click"
                Padding="16,8" FontSize="12"/>
      </Grid>
    </Border>

    <!-- Backup list -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="ListLabel" Text="BACKUP FILES" FontSize="10"
                   Foreground="#7F9189" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="BackupsPanel" Spacing="0"/>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Visibility="Collapsed">
          <FontIcon Glyph="&#xE777;" FontSize="32" Foreground="#D0DBD5" HorizontalAlignment="Center"/>
          <TextBlock Text="No backups yet"
                     FontSize="13" Foreground="#9AA6A1" HorizontalAlignment="Center"/>
          <TextBlock Text="A registry clean creates its .reg restore point here before removing anything"
                     FontSize="11" Foreground="#B0BBB6" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer / status -->
    <TextBlock Grid.Row="3" x:Name="FooterText" Text=""
               FontSize="11" Foreground="#9AA6A1" TextWrapping="Wrap"/>
  </Grid>
</Page>