<Page x:Class="CleanMachine.Windows.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE9A9;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Startup Apps" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Control which programs start with Windows. Disabling an entry keeps it installed but stops it from launching at logon; the change is visible in Task Manager too."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Row 1 fills the remaining page height. -->
    <Border Grid.Row="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="STARTUP ENTRIES" FontSize="10" Foreground="#7F9189" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="StartupList" Spacing="2"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="18,10"/>
      <TextBlock x:Name="StatusText" Foreground="#6E8178" TextWrapping="Wrap"
                 Margin="14,0" VerticalAlignment="Center"
                 HorizontalAlignment="Left" MaxWidth="640"/>
    </Grid>
  </Grid>
</Page>
