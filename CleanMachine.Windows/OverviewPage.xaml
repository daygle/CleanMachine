<Page x:Class="CleanMachine.Windows.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5EBE7"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#BFE5D5"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F3F8F5"/>
    <SolidColorBrush x:Key="CardPressedBrush" Color="#EAF4EE"/>
    <SolidColorBrush x:Key="CardDisabledBrush" Color="#F5F7F6"/>
    <Style x:Key="QuickActionCard" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RootBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="Content"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="PointerOver">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CardHoverBrush}"/>
                      </ObjectAnimationUsingKeyFrames>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CardHoverBorderBrush}"/>
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CardPressedBrush}"/>
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CardDisabledBrush}"/>
                      </ObjectAnimationUsingKeyFrames>
                      <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>
  <StackPanel Spacing="18">
    <StackPanel>
      <TextBlock Text="●  ALL SYSTEMS CLEAR" Foreground="#6EA587" FontSize="10"/>
      <TextBlock Text="Your privacy, handled." Foreground="#273630" FontSize="36" FontWeight="SemiBold" Margin="0,10,0,0"/>
      <TextBlock Text="Review safe cleanup actions from one calm dashboard." Foreground="#89958F" FontSize="13" Margin="0,10,0,0"/>
    </StackPanel>
    <Border Background="#DCEFE5" CornerRadius="13" Padding="30">
      <StackPanel>
        <TextBlock Text="READY WHEN YOU ARE" Foreground="#7F9189" FontSize="10"/>
        <TextBlock Text="Clear the clutter. Keep the good stuff." Foreground="#254239" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,8"/>
        <TextBlock Text="Start with a review-first scan. CleanMachine never removes protected personal data automatically." Foreground="#709086" TextWrapping="Wrap" MaxWidth="540"/>
        <Button Content="Open Browser Cleaner" Click="OpenCleaner_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Background="#286E58" Foreground="White" Padding="18,10"/>
      </StackPanel>
    </Border>
    <Grid ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource QuickActionCard}" Click="OpenRegistry_Click">
        <StackPanel Spacing="10">
          <Border Width="36" Height="36" CornerRadius="10" Background="#EAF4EE" HorizontalAlignment="Left">
            <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="#4B7769" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Registry Care" Foreground="#273630" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="Read-only review" Foreground="#89958F" FontSize="11"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Style="{StaticResource QuickActionCard}" Click="OpenWindows_Click">
        <StackPanel Spacing="10">
          <Border Width="36" Height="36" CornerRadius="10" Background="#EAF4EE" HorizontalAlignment="Left">
            <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#4B7769" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Windows Cleanup" Foreground="#273630" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="Safe temporary files" Foreground="#89958F" FontSize="11"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Style="{StaticResource QuickActionCard}" Click="OpenUpdates_Click">
        <StackPanel Spacing="10">
          <Border Width="36" Height="36" CornerRadius="10" Background="#EAF4EE" HorizontalAlignment="Left">
            <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="#4B7769" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Updates" Foreground="#273630" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="Verified releases" Foreground="#89958F" FontSize="11"/>
        </StackPanel>
      </Button>
    </Grid>
  </StackPanel>
</Page>
