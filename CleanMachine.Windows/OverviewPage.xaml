<Page x:Class="CleanMachine.Windows.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CleanMachine.Windows">
  <StackPanel Spacing="18">
    <!-- Hero -->
    <StackPanel>
      <TextBlock Text="OVERVIEW" Foreground="#6EA587" FontSize="10"/>
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
        <FontIcon Glyph="&#xE80F;" FontSize="32" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Your PC at a glance" Foreground="#273630" FontSize="36" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="See what you've cleaned, run a quick clean for each area, and check for updates - all from here." Foreground="#89958F" FontSize="13" Margin="0,10,0,0"/>
    </StackPanel>
    <!-- Lifetime / recent cleanup stats -->
    <Grid ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <controls:MetricCard Grid.Column="0" x:Name="StatsItems" Label="ITEMS CLEANED" Value="-"/>
      <controls:MetricCard Grid.Column="1" x:Name="StatsSpace" Label="SPACE RECOVERED" Value="-"/>
      <controls:MetricCard Grid.Column="2" x:Name="StatsLast" Label="LAST CLEANUP" Value="-"/>
    </Grid>
    <!-- Update status (compact) -->
    <Border Background="#FFFFFF" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14,10">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
          <TextBlock x:Name="UpdateStatusText" Text="" Foreground="#254239" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdateDetailText" TextWrapping="Wrap" Foreground="#89958F" FontSize="11"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" Width="110" Visibility="Collapsed" VerticalAlignment="Center"/>
          <Button x:Name="UpdateNowButton" Content="Update Now" Click="UpdateNow_Click"
                  Background="#286E58" Foreground="White" Padding="14,7" Visibility="Collapsed"/>
          <Button x:Name="UpdateCheckButton" Content="Check for Updates" Click="CheckUpdates_Click" Padding="14,7"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- Quick Clean: one-click clean per area, plus a gear to choose what each
         includes. Summaries show what could be cleaned right now (refreshed on load
         and after every clean). -->
    <TextBlock Text="QUICK CLEAN" FontSize="10" Foreground="#7F9189"/>
    <Grid ColumnSpacing="14" RowSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
              <Border Width="34" Height="34" CornerRadius="9" Background="#EAF4EE">
                <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="#4B7769" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Browser Cleaner" Foreground="#273630" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="BrowsersSummary" Text="Checking..." Foreground="#89958F" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Click="BrowsersSettings_Click" VerticalAlignment="Top" Padding="8,6"
                    ToolTipService.ToolTip="Choose what Quick Clean includes">
              <FontIcon Glyph="&#xE713;" FontSize="14"/>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="BrowsersCleanButton" Content="Quick Clean" Click="BrowsersQuickClean_Click"
                    Background="#286E58" Foreground="White" Padding="16,8"/>
            <Button Content="Open" Click="OpenCleaner_Click" Padding="16,8"/>
            <ProgressBar x:Name="BrowsersProgress" IsIndeterminate="True" Width="90" Visibility="Collapsed" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="BrowsersResult" Visibility="Collapsed" Foreground="#6E8178" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
              <Border Width="34" Height="34" CornerRadius="9" Background="#EAF4EE">
                <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#4B7769" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Windows Cleanup" Foreground="#273630" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="WindowsSummary" Text="Checking..." Foreground="#89958F" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Click="WindowsSettings_Click" VerticalAlignment="Top" Padding="8,6"
                    ToolTipService.ToolTip="Choose what Quick Clean includes">
              <FontIcon Glyph="&#xE713;" FontSize="14"/>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="WindowsCleanButton" Content="Quick Clean" Click="WindowsQuickClean_Click"
                    Background="#286E58" Foreground="White" Padding="16,8"/>
            <Button Content="Open" Click="OpenWindows_Click" Padding="16,8"/>
            <ProgressBar x:Name="WindowsProgress" IsIndeterminate="True" Width="90" Visibility="Collapsed" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="WindowsResult" Visibility="Collapsed" Foreground="#6E8178" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
              <Border Width="34" Height="34" CornerRadius="9" Background="#EAF4EE">
                <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="#4B7769" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Registry Care" Foreground="#273630" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="RegistrySummary" Text="Checking..." Foreground="#89958F" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Click="RegistrySettings_Click" VerticalAlignment="Top" Padding="8,6"
                    ToolTipService.ToolTip="Choose what Quick Clean includes">
              <FontIcon Glyph="&#xE713;" FontSize="14"/>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RegistryCleanButton" Content="Quick Clean" Click="RegistryQuickClean_Click"
                    Background="#286E58" Foreground="White" Padding="16,8"/>
            <Button Content="Open" Click="OpenRegistry_Click" Padding="16,8"/>
            <ProgressBar x:Name="RegistryProgress" IsIndeterminate="True" Width="90" Visibility="Collapsed" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="RegistryResult" Visibility="Collapsed" Foreground="#6E8178" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
              <Border Width="34" Height="34" CornerRadius="9" Background="#EAF4EE">
                <FontIcon Glyph="&#xE7B8;" FontSize="15" Foreground="#4B7769" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Application Cleanup" Foreground="#273630" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="AppsSummary" Text="Checking..." Foreground="#89958F" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Click="AppsSettings_Click" VerticalAlignment="Top" Padding="8,6"
                    ToolTipService.ToolTip="Choose what Quick Clean includes">
              <FontIcon Glyph="&#xE713;" FontSize="14"/>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AppsCleanButton" Content="Quick Clean" Click="AppsQuickClean_Click"
                    Background="#286E58" Foreground="White" Padding="16,8"/>
            <Button Content="Open" Click="OpenApps_Click" Padding="16,8"/>
            <ProgressBar x:Name="AppsProgress" IsIndeterminate="True" Width="90" Visibility="Collapsed" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="AppsResult" Visibility="Collapsed" Foreground="#6E8178" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</Page>
