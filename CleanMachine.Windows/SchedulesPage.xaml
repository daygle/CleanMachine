<Page x:Class="CleanMachine.Windows.SchedulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Schedules" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Automate cleanup on a schedule or at logon. Schedules are registered with Windows Task Scheduler, so they run even when CleanMachine is closed."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: schedule list -->
      <Border Grid.Column="0" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="SCHEDULES" FontSize="10" Foreground="#7F9189" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ScheduleList" Spacing="4"/>
          </ScrollViewer>
          <Button Grid.Row="2" x:Name="AddButton" Content="+ Add Schedule" Click="Add_Click"
                  Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Right: editor -->
      <Border Grid.Column="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="EditorPanel" Spacing="10">
            <TextBlock x:Name="EditorHeadline" Text="No Schedule Selected"
                       FontSize="16" FontWeight="SemiBold" Foreground="#273630"/>
            <TextBlock x:Name="EditorHint" Text="Add a schedule or pick one on the left to edit it."
                       FontSize="12" Foreground="#89958F" TextWrapping="Wrap"/>

            <StackPanel x:Name="EditorFields" Spacing="10" Visibility="Collapsed">
              <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Scheduled cleanup"/>
              <CheckBox x:Name="EnabledCheck" Content="Enabled"/>

              <ComboBox x:Name="TriggerCombo" Header="Trigger" HorizontalAlignment="Stretch" SelectionChanged="Trigger_Changed">
                <ComboBoxItem Content="Daily"/>
                <ComboBoxItem Content="Weekly"/>
                <ComboBoxItem Content="Monthly"/>
                <ComboBoxItem Content="At Logon"/>
              </ComboBox>

              <StackPanel x:Name="TimePanel" Orientation="Horizontal" Spacing="10">
                <NumberBox x:Name="HourBox" Header="Hour" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact" Width="120"/>
                <NumberBox x:Name="MinuteBox" Header="Minute" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact" Width="120"/>
              </StackPanel>

              <ComboBox x:Name="DayOfWeekCombo" Header="Day of week" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Sunday"/>
                <ComboBoxItem Content="Monday"/>
                <ComboBoxItem Content="Tuesday"/>
                <ComboBoxItem Content="Wednesday"/>
                <ComboBoxItem Content="Thursday"/>
                <ComboBoxItem Content="Friday"/>
                <ComboBoxItem Content="Saturday"/>
              </ComboBox>

              <NumberBox x:Name="DayOfMonthBox" Header="Day of month" Minimum="1" Maximum="31" SpinButtonPlacementMode="Compact" Width="160"/>

              <Grid Margin="0,4,0,0">
                <TextBlock Text="ITEMS TO CLEAN" FontSize="10" Foreground="#7F9189" VerticalAlignment="Center"/>
                <CheckBox x:Name="SelectAllItems" Content="Select All" FontSize="12" MinWidth="0"
                          HorizontalAlignment="Right" Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
              </Grid>
              <StackPanel x:Name="ItemsPanel" Spacing="2"/>

              <ComboBox x:Name="AfterCombo" Header="After cleanup" HorizontalAlignment="Stretch" SelectionChanged="After_Changed">
                <ComboBoxItem Content="Do nothing"/>
                <ComboBoxItem Content="Notify me"/>
                <ComboBoxItem Content="Shut down the PC"/>
                <ComboBoxItem Content="Restart the PC"/>
                <ComboBoxItem Content="Sleep"/>
              </ComboBox>
              <TextBlock x:Name="AfterWarning" Foreground="#C7775D" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                         Text="The PC will power off 60 seconds after a successful clean. Run 'shutdown /a' to abort."/>

              <CheckBox x:Name="WakeCheck" Content="Wake the computer to run this task" Checked="Wake_Changed" Unchecked="Wake_Changed"/>
              <TextBlock x:Name="WakeHint" Foreground="#89958F" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                         Text="Wakes the PC from sleep at the scheduled time. Requires your Windows power settings to allow wake timers, otherwise it is ignored."/>

              <TextBlock x:Name="StatusText" Foreground="#6E8178" FontSize="12" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Save Schedule" Click="Save_Click"
                        Background="#286E58" Foreground="White" Padding="18,8"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" Padding="18,8" Visibility="Collapsed"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Foreground="#89958F" FontSize="11" TextWrapping="Wrap"
               Text="Tasks appear under the 'CleanMachine' folder in Windows Task Scheduler. They run with least privilege, so they clean per-user items only."/>
  </Grid>
</Page>
