<UserControl x:Class="CleanMachine.Windows.BrowserCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="15"><StackPanel><Image Source="ms-appx:///Assets/AppLogo.png" Width="24" Height="24" HorizontalAlignment="Left"/><TextBlock Text="{x:Bind BrowserName, Mode=OneWay}" Foreground="#465650" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,18"/><Grid><TextBlock Text="Protected" Foreground="#A0AAA6" FontSize="10"/><TextBlock Text="{x:Bind DataSize, Mode=OneWay}" Foreground="#6D7A74" FontSize="10" HorizontalAlignment="Right"/></Grid><ProgressBar Value="58" Height="4" Margin="0,10,0,0" Foreground="#86C8A8" Background="#EDF1EF"/></StackPanel></Border></UserControl>
