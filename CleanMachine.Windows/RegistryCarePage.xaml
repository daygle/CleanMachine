<Page x:Class="CleanMachine.Windows.RegistryCarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <TextBlock Text="Registry Care" FontSize="30" FontWeight="SemiBold" Foreground="#273630"/>
    <TextBlock Text="Read-only, current-user scanning. Nothing is deleted automatically."
               Foreground="#89958F"/>
    <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="18">
      <StackPanel Spacing="12">
        <TextBlock x:Name="StatusText" Text="Ready for a safe scan." TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ScanButton" Content="Scan registry" Click="Scan_Click"
                  HorizontalAlignment="Left" Background="#286E58" Foreground="White" Padding="18,10"/>
          <Button x:Name="RestoreButton" Content="Restore last backup" Click="Restore_Click"
                  HorizontalAlignment="Left" Visibility="Collapsed" Padding="18,10"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</Page>
