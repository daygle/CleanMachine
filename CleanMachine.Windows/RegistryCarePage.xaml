<Page x:Class="CleanMachine.Windows.RegistryCarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xEA18;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Registry Care" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Analyze scans the registry read-only. Cleaning removes only the items you tick, and only after a verified backup."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="14" MaxHeight="470">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left box: findings to clean -->
      <Border Grid.Column="0" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="ISSUES TO FIX" FontSize="10" Foreground="#7F9189" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" MaxHeight="410" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FindingsPanel" Spacing="2"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Right box: analysis / cleaning report -->
      <Border Grid.Column="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" x:Name="ReportHeadline" Text="No analysis performed yet."
                     FontSize="16" FontWeight="SemiBold" Foreground="#273630" Margin="0,0,0,4" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" x:Name="StatusText" Text="Click Analyze to scan the registry."
                     FontSize="12" Foreground="#6E8178" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="2">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/>
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ReportPanel" Spacing="2"/>
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Button x:Name="ScanButton" Content="Analyze" Click="Scan_Click"
              Background="#286E58" Foreground="White" Padding="26,10" HorizontalAlignment="Left"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="RestoreButton" Content="Restore Last Backup" Click="Restore_Click"
                Visibility="Collapsed" Padding="18,10"/>
        <Button x:Name="CleanButton" Content="Clean" Click="Clean_Click"
                Background="#286E58" Foreground="White" Padding="26,10"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
