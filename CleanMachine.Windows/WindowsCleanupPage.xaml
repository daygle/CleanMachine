<Page x:Class="CleanMachine.Windows.WindowsCleanupPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Spacing="16"><TextBlock Text="Windows Cleanup" FontSize="30" FontWeight="SemiBold" Foreground="#273630"/><TextBlock Text="Review temporary files and recreatable caches before anything is removed." Foreground="#89958F"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ScanButton" Content="Scan Windows" Click="Scan_Click" Background="#286E58" Foreground="White" Padding="18,10"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="18,10"/></StackPanel><ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed"/><ListView x:Name="FindingList" MaxHeight="260"/><TextBlock x:Name="StatusText" Text="Safe categories only; advanced locations require separate review." Foreground="#6E8178" TextWrapping="Wrap"/></StackPanel></Page>
