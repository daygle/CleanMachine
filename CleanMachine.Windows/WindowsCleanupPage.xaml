<Page x:Class="CleanMachine.Windows.WindowsCleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <FontIcon Glyph="&#xE9D5;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
      <TextBlock Text="Windows Cleanup" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Text="Choose which items to clean. Selections are saved automatically; review and advanced items require confirmation before cleaning."
               Foreground="#89958F" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click"
              Background="#286E58" Foreground="White" Padding="18,10"/>
      <Button x:Name="CleanButton" Content="Clean Enabled Items" Click="Clean_Click"
              Background="#286E58" Foreground="White" Padding="18,10"/>
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="18,10"/>
    </StackPanel>

    <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed"/>

    <ScrollViewer MaxHeight="420">
      <StackPanel x:Name="CategoryPanel" Spacing="6"/>
    </ScrollViewer>

    <TextBlock x:Name="StatusText" Text="No scan performed yet." Foreground="#6E8178" TextWrapping="Wrap"/>
  </StackPanel>
</Page>
