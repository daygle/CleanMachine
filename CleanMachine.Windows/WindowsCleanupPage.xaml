<Page x:Class="CleanMachine.Windows.WindowsCleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE9D5;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Windows Cleanup" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Click Analyze to scan; categories that have something to clean are listed on the left. Tick what to remove, then Clean. Turn on Show All to see empty categories too. Selections are saved automatically."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: category list grouped by area -->
      <Border Grid.Column="0" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="CATEGORIES" FontSize="10" Foreground="#7F9189" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CategoryPanel" Spacing="2"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Right: analysis summary and per-category file drill-down -->
      <Border Grid.Column="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Summary header: icon tile, what is being viewed, and back navigation -->
          <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="#E2F3E9" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE9D5;" FontSize="18" Foreground="#398A6D"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailHeadline" Text="Windows Cleanup"
                           FontSize="17" FontWeight="SemiBold" Foreground="#273630"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border x:Name="DetailGroupBadge" Grid.Column="1" Background="#EAF4EE" CornerRadius="5" Padding="7,3"
                        VerticalAlignment="Center" Visibility="Collapsed">
                  <TextBlock x:Name="DetailGroupBadgeText" Text="" FontSize="9"
                             FontWeight="SemiBold" Foreground="#4B7769" CharacterSpacing="40"/>
                </Border>
              </Grid>
              <TextBlock x:Name="DetailSubHeadline" Text="Click Analyze to scan, then pick a category to preview its files."
                         FontSize="11" Foreground="#89958F" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="DetailBackButton" Grid.Column="2" Click="DetailBack_Click"
                    Style="{ThemeResource AccentButtonStyle}" Padding="8,4" FontSize="12"
                    Visibility="Collapsed" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                <TextBlock Text="Back"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- Live summary: what the current view / selection totals -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Border Background="#F2F7F4" CornerRadius="7" Padding="12,7">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="#6ABD97" VerticalAlignment="Center"/>
                  <TextBlock Text="TO CLEAN" FontSize="9" Foreground="#7F9189" CharacterSpacing="60"/>
                </StackPanel>
                <TextBlock x:Name="ChipSizeValue" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#273630"/>
              </StackPanel>
            </Border>
            <Border Background="#F2F7F4" CornerRadius="7" Padding="12,7">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="#5B99AD" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ChipMidLabel" Text="FILES" FontSize="9" Foreground="#7F9189" CharacterSpacing="60"/>
                </StackPanel>
                <TextBlock x:Name="ChipFilesValue" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#273630"/>
              </StackPanel>
            </Border>
            <Border Background="#F2F7F4" CornerRadius="7" Padding="12,7">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="#C7775D" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ChipRightLabel" Text="ITEMS" FontSize="9" Foreground="#7F9189" CharacterSpacing="60"/>
                </StackPanel>
                <TextBlock x:Name="ChipItemsValue" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#273630"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock Grid.Row="2" x:Name="StatusText" Text="Select items and click Analyze."
                     FontSize="12" Foreground="#6E8178" TextWrapping="Wrap"/>
          <ProgressBar Grid.Row="3" x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed"/>
          <ScrollViewer Grid.Row="4" x:Name="ReportScroller" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReportPanel" Spacing="8"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
        <Button x:Name="AnalyzeButton" Content="Analyze" Click="Analyze_Click"
                Background="#286E58" Foreground="White" Padding="26,10"/>
        <CheckBox x:Name="ShowCleanCheck" Content="Show All" VerticalAlignment="Center"
                  IsChecked="False" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        <CheckBox x:Name="SelectAllCheck" Content="Select All" VerticalAlignment="Center"
                  Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <CheckBox x:Name="SecureDeleteCheck" Content="Secure Delete" VerticalAlignment="Center"/>
        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="18,10"/>
        <Button x:Name="CleanButton" Content="Clean" Click="Clean_Click"
                Background="#286E58" Foreground="White" Padding="26,10"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
