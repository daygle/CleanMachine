<Page x:Class="CleanMachine.Windows.ActivityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <FontIcon Glyph="&#xE81C;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
      <TextBlock Text="Activity" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Row 1 fills the remaining page height. -->
    <ListView Grid.Row="1" x:Name="ActivityList"/>

    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Loading activity…" Foreground="#89958F"/>
    <Button Grid.Row="3" Content="Clear History" Click="Clear_Click" HorizontalAlignment="Left" Padding="16,9"/>
  </Grid>
</Page>
