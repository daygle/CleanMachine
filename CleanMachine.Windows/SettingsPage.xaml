<Page x:Class="CleanMachine.Windows.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock Text="AGENT" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="AgentToggle" Content="Start background agent with Windows"/>

      <TextBlock Text="BROWSER MONITORING" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="CleanToggle" Content="Monitor supported browsers and clean caches when they close"/>
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid MinWidth="460">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Browser" FontSize="11" Foreground="#7F9189" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="After closing" FontSize="11" Foreground="#7F9189" Margin="0,0,0,6"/>
          <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ChromeEnabled" Content="Google Chrome" Margin="0,4,0,4"/>
          <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ChromeAction" SelectedIndex="2" Margin="0,4,0,4">
            <ComboBoxItem Content="Do nothing"/>
            <ComboBoxItem Content="Clean silently"/>
            <ComboBoxItem Content="Clean and notify"/>
          </ComboBox>
          <CheckBox Grid.Row="2" Grid.Column="0" x:Name="EdgeEnabled" Content="Microsoft Edge" Margin="0,4,0,4"/>
          <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EdgeAction" SelectedIndex="2" Margin="0,4,0,4">
            <ComboBoxItem Content="Do nothing"/>
            <ComboBoxItem Content="Clean silently"/>
            <ComboBoxItem Content="Clean and notify"/>
          </ComboBox>
          <CheckBox Grid.Row="3" Grid.Column="0" x:Name="FirefoxEnabled" Content="Firefox" Margin="0,4,0,4"/>
          <ComboBox Grid.Row="3" Grid.Column="1" x:Name="FirefoxAction" SelectedIndex="2" Margin="0,4,0,4">
            <ComboBoxItem Content="Do nothing"/>
            <ComboBoxItem Content="Clean silently"/>
            <ComboBoxItem Content="Clean and notify"/>
          </ComboBox>
        </Grid>
      </Border>
      <TextBlock Text="Caches only. Open browsers are skipped; passwords, bookmarks, cookies, and history are never touched."
                 FontSize="11" Foreground="#89958F" TextWrapping="Wrap"/>

      <TextBlock Text="SYSTEM MONITORING" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="SystemMonitoringToggle" Content="Clean safe items when free disk space drops below"/>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
        <NumberBox x:Name="FreeSpaceBox" Value="1" Minimum="0.1" Maximum="100" SpinButtonPlacementMode="Inline"
                   SmallChange="0.1" LargeChange="1" Width="120"/>
        <TextBlock Text="GB on the Windows drive" VerticalAlignment="Center" Foreground="#53635B"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
        <TextBlock Text="Action:" VerticalAlignment="Center" Foreground="#53635B"/>
        <ComboBox x:Name="SystemMonitorAction" SelectedIndex="1" Width="220">
          <ComboBoxItem Content="Do nothing"/>
          <ComboBoxItem Content="Clean silently"/>
          <ComboBoxItem Content="Clean and notify"/>
        </ComboBox>
      </StackPanel>
      <TextBlock Text="Only safe categories you have enabled are cleaned. Runs at most once per hour and waits until space recovers before triggering again."
                 FontSize="11" Foreground="#89958F" TextWrapping="Wrap"/>

      <TextBlock Text="UPDATES" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="UpdateCheckToggle" Content="Check for updates automatically"/>

      <TextBlock Text="WINDOW" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="ShowInTaskbarToggle" Content="Show in taskbar"/>
      <CheckBox x:Name="StartMinimizedToTrayToggle" Content="Minimize to system tray when program starts up"/>
      <CheckBox x:Name="CloseToTrayToggle" Content="Minimize to system tray when program is closed"/>
      <CheckBox x:Name="MinimizeToTrayToggle" Content="Minimize to system tray when minimized"/>

      <TextBlock Text="SECURE DELETE" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <StackPanel Spacing="4">
        <TextBlock Text="Default wipe method" FontSize="12" Foreground="#53635B"/>
        <ComboBox x:Name="WipeMethodCombo" SelectedIndex="0" Width="300">
          <ComboBoxItem Content="Simple zero-fill (1 pass)"/>
          <ComboBoxItem Content="US DoD 5220.22-M (3 passes)"/>
          <ComboBoxItem Content="US DoD 5220.22-M ECE (7 passes)"/>
          <ComboBoxItem Content="Peter Gutmann (35 passes)"/>
          <ComboBoxItem Content="Custom"/>
        </ComboBox>
      </StackPanel>

      <TextBlock Text="EXCLUSIONS" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <TextBlock Text="Add folder paths to exclude from cleanup (one per line):"
                 FontSize="12" Foreground="#53635B"/>
      <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" Height="80"
               TextWrapping="Wrap" FontSize="12" Padding="8"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Restore Defaults" Click="RestoreDefaults_Click" Padding="16,9"/>
        <Button Content="Save Settings" Click="Save_Click"
                Background="#286E58" Foreground="White" Padding="18,10"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="#6E8178"/>
    </StackPanel>
  </ScrollViewer>
</Page>
