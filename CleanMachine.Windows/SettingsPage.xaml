<Page x:Class="CleanMachine.Windows.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock Text="SYSTEM MONITORING" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="SystemMonitoringToggle" Content="Clean safe items when free disk space drops below"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
        <NumberBox x:Name="FreeSpaceBox" Value="1" Minimum="0.1" Maximum="100" SpinButtonPlacementMode="Inline"
                   SmallChange="0.1" LargeChange="1" Width="120" ValueChanged="FreeSpace_ValueChanged"/>
        <ComboBox x:Name="FreeSpaceUnit" Width="80" VerticalAlignment="Center" SelectionChanged="FreeSpaceUnit_Changed">
          <ComboBoxItem Content="GB"/>
          <ComboBoxItem Content="MB"/>
        </ComboBox>
        <TextBlock Text="on the Windows drive" VerticalAlignment="Center" Foreground="#53635B"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
        <TextBlock Text="Action:" VerticalAlignment="Center" Foreground="#53635B"/>
        <ComboBox x:Name="SystemMonitorAction" SelectedIndex="1" Width="220" SelectionChanged="Setting_ComboChanged">
          <ComboBoxItem Content="Do nothing"/>
          <ComboBoxItem Content="Clean silently"/>
          <ComboBoxItem Content="Clean and notify"/>
        </ComboBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
        <Button Content="Choose items…" Click="ChooseMonitorItems_Click" Padding="14,8"/>
        <TextBlock x:Name="MonitorItemsSummary" VerticalAlignment="Center" FontSize="11" Foreground="#89958F"/>
      </StackPanel>
      <TextBlock Text="Only safe categories are cleaned. Choose the items above, or leave it on the default to clean every safe category enabled on the Windows Cleanup page. Runs at most once per hour and waits until space recovers before triggering again. While enabled, CleanMachine runs in the background and starts with Windows so it can watch free space."
                 FontSize="11" Foreground="#89958F" TextWrapping="Wrap"/>

      <TextBlock Text="UPDATES" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="UpdateCheckToggle" Content="Check for updates automatically"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <CheckBox x:Name="SkipUpdateConfirmToggle" Content="Install updates without asking me to confirm first"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <TextBlock Text="Windows still shows its administrator-permission prompt for each update; this only skips CleanMachine's own confirmation step."
                 FontSize="11" Foreground="#89958F" TextWrapping="Wrap" Margin="26,-8,0,0"/>

      <TextBlock Text="WINDOW" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <CheckBox x:Name="StartWithWindowsToggle" Content="Start CleanMachine when I sign in to Windows"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <TextBlock x:Name="StartWithWindowsHint"
                 Text="Background cleaning (browser-close cleanup or low-disk monitoring) also starts CleanMachine with Windows so it can run while closed."
                 FontSize="11" Foreground="#89958F" TextWrapping="Wrap" Margin="26,-8,0,0"/>
      <CheckBox x:Name="ShowInTaskbarToggle" Content="Show in taskbar"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <CheckBox x:Name="StartMinimizedToTrayToggle" Content="Minimize to system tray when program starts up"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <CheckBox x:Name="CloseToTrayToggle" Content="Minimize to system tray when program is closed"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>
      <CheckBox x:Name="MinimizeToTrayToggle" Content="Minimize to system tray when minimized"
                Checked="Setting_Changed" Unchecked="Setting_Changed"/>

      <TextBlock Text="SECURE DELETE" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <StackPanel Spacing="4">
        <TextBlock Text="Default wipe method" FontSize="12" Foreground="#53635B"/>
        <ComboBox x:Name="WipeMethodCombo" SelectedIndex="0" Width="300" SelectionChanged="Setting_ComboChanged">
          <ComboBoxItem Content="Simple zero-fill (1 pass)"/>
          <ComboBoxItem Content="US DoD 5220.22-M (3 passes)"/>
          <ComboBoxItem Content="US DoD 5220.22-M ECE (7 passes)"/>
          <ComboBoxItem Content="Peter Gutmann (35 passes)"/>
          <ComboBoxItem Content="Custom"/>
        </ComboBox>
      </StackPanel>

      <TextBlock Text="EXCLUSIONS" FontSize="10" Foreground="#7F9189" Margin="0,8,0,0"/>
      <TextBlock Text="Add folder paths to exclude from cleanup (one per line):"
                 FontSize="12" Foreground="#53635B"/>
      <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" Height="80"
               TextWrapping="Wrap" FontSize="12" Padding="8" LostFocus="Setting_LostFocus"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Restore Defaults" Click="RestoreDefaults_Click" Padding="16,9"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="#6E8178"/>
    </StackPanel>
  </ScrollViewer>
</Page>
