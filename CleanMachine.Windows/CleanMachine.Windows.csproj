<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CleanMachine.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- WindowsAppSDKSelfContained rejects AnyCPU ("requires a supported Windows
         architecture"), so a plain `dotnet build` failed unless the caller passed
         -p:Platform. CI and the release workflow always do, which is why this stayed
         hidden. Default to x64 - the architecture this app ships and runs as. An
         explicit -p:Platform from the command line is a global property and still wins,
         so the x86/ARM64 release matrix is unaffected. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Bundle the Windows App SDK runtime with the app so the unpackaged exe runs
         without depending on the installed runtime/bootstrapper version. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- Pinned (not $(OutputPath)-relative): with -t:Publish / single-project MSIX,
         $(OutputPath) can be empty at evaluation time, which made the package land at
         a drive root (e.g. D:\AppPackages). Keep it inside bin where CI globs for it. -->
    <AppxPackageDir>$(MSBuildProjectDirectory)\bin\AppPackages\</AppxPackageDir>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <!-- The Microsoft Store is the only distribution channel, and Partner Center
         prefers one multi-architecture bundle over per-architecture packages. A
         bundle is produced unsigned: the Store signs it on ingestion, so no
         code-signing certificate has to be purchased or configured. -->
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <EnableDefaultApplicationDefinitionItems>true</EnableDefaultApplicationDefinitionItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CleanMachine</AssemblyName>
    <!-- Stamp the assembly version from the release version (passed as
         ApplicationDisplayVersion by the release workflow) so the unpackaged
         installer build reports its true version in update checks; without this
         the exe stays at the default 1.0.0.0 and update checks always offer
         the latest release as an "update". -->
    <Version Condition="'$(ApplicationDisplayVersion)' != ''">$(ApplicationDisplayVersion)</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the icon/tile assets with the app (unpackaged + MSIX) so the in-app
         logo and the window title-bar icon resolve at runtime. -->
    <Content Include="Assets\**" Exclude="Assets\generate_icons.py;Assets\icon-master.svg" />
    <!-- Belt and braces: Remove always evaluates after Include, so these dev files
         can never slip into the package even if the glob Exclude above is outfoxed
         by wildcard evaluation order. -->
    <Content Remove="Assets\generate_icons.py;Assets\icon-master.svg" />
    <!-- Also embed the sidebar mark in the assembly. Loose Content files can fail to
         be laid down (or resolved) in unpackaged/installer builds, which showed the
         sidebar logo blank; the embedded copy is always present, with the loose file
         kept as a fallback. -->
    <EmbeddedResource Include="Assets\AppLogo.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CleanMachine.Windows.Tests" />
  </ItemGroup>
</Project>
