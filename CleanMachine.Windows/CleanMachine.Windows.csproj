<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CleanMachine.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Bundle the Windows App SDK runtime with the app so the unpackaged exe runs
         without depending on the installed runtime/bootstrapper version. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- Pinned (not $(OutputPath)-relative): with -t:Publish / single-project MSIX,
         $(OutputPath) can be empty at evaluation time, which made the package land at
         a drive root (e.g. D:\AppPackages). Keep it inside bin where CI globs for it. -->
    <AppxPackageDir>$(MSBuildProjectDirectory)\bin\AppPackages\</AppxPackageDir>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxBundle>Never</AppxBundle>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <EnableDefaultApplicationDefinitionItems>true</EnableDefaultApplicationDefinitionItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CleanMachine</AssemblyName>
    <!-- Stamp the assembly version from the release version (passed as
         ApplicationDisplayVersion by the release workflow) so the unpackaged
         installer build reports its true version in update checks; without this
         the exe stays at the default 1.0.0.0 and update checks always offer
         the latest release as an "update". -->
    <Version Condition="'$(ApplicationDisplayVersion)' != ''">$(ApplicationDisplayVersion)</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.3916" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the icon/tile assets with the app (unpackaged + MSIX) so the in-app
         logo and the window title-bar icon resolve at runtime. -->
    <Content Include="Assets\**" Exclude="Assets\generate_icons.py;Assets\icon-master.svg" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CleanMachine.Windows.Tests" />
  </ItemGroup>
</Project>
