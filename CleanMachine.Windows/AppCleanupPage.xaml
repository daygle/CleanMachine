<Page x:Class="CleanMachine.Windows.AppCleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE7B8;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Application Cleanup" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Remove temporary files from installed applications. Detected apps are shown with their cache sizes. Close apps before cleaning."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: app list grouped by category -->
      <Border Grid.Column="0" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="APPLICATIONS" FontSize="10" Foreground="#7F9189" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppListPanel" Spacing="2"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Right: details / status. The detail list fills the remaining height
           directly from the Grid cell (a StackPanel would measure it with
           infinite height and let it overflow the card). -->
      <Border Grid.Column="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DetailBackButton" Grid.Column="0" Click="DetailBack_Click"
                    Style="{ThemeResource AccentButtonStyle}" Padding="6,2" FontSize="12"
                    Visibility="Collapsed" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                <TextBlock Text="Back"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="DetailHeadline" Grid.Column="1" Text="Select an application"
                       FontSize="16" FontWeight="SemiBold" Foreground="#273630" Margin="6,0,0,4" TextWrapping="Wrap"/>
          </Grid>
          <TextBlock Grid.Row="1" x:Name="StatusText" Text="Click Scan to detect installed applications and measure their temp files."
                     FontSize="12" Foreground="#6E8178" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <ProgressBar Grid.Row="2" x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DetailPanel" Spacing="2"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2">        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
        <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click"
              Background="#286E58" Foreground="White" Padding="26,10"/>
        <CheckBox x:Name="ShowCleanCheck" Content="Show All" VerticalAlignment="Center"
                  IsChecked="False" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <CheckBox x:Name="SecureDeleteCheck" Content="Secure Delete" VerticalAlignment="Center"/>
        <Button x:Name="CleanButton" Content="Clean Selected" Click="Clean_Click"
                Padding="18,10" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
