<Page x:Class="CleanMachine.Windows.SecureDeletePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <FontIcon Glyph="&#xE7C3;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
      <TextBlock Text="Secure Delete" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="Explicit files only. Multi-pass overwrite is not reliable SSD sanitization." Foreground="#89958F" TextWrapping="Wrap"/>

    <ComboBox Grid.Row="2" x:Name="Method" SelectedIndex="0" Width="280" HorizontalAlignment="Left">
      <ComboBoxItem Content="Simple zero-fill (1 pass)"/>
      <ComboBoxItem Content="US DoD 5220.22-M (3 passes)"/>
      <ComboBoxItem Content="US DoD 5220.22-M ECE (7 passes)"/>
      <ComboBoxItem Content="Peter Gutmann (35 passes)"/>
      <ComboBoxItem Content="Custom (1–35 passes)"/>
    </ComboBox>

    <StackPanel Grid.Row="3" Spacing="8">
      <CheckBox x:Name="SsdAcknowledged" Content="I understand SSD overwriting is not guaranteed"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ChooseButton" Content="Choose Files" Click="Choose_Click" Background="#286E58" Foreground="White" Padding="18,10"/>
        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="18,10"/>
      </StackPanel>
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed"/>
    </StackPanel>

    <!-- Row 4 fills the remaining page height; the status line sits under the list. -->
    <Grid Grid.Row="4" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ListView Grid.Row="0" x:Name="FileList"/>
      <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="#6E8178" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Page>
