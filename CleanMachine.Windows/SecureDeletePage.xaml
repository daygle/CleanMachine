<Page x:Class="CleanMachine.Windows.SecureDeletePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Spacing="16"><TextBlock Text="Secure Delete" FontSize="30" FontWeight="SemiBold" Foreground="#273630"/><TextBlock Text="Explicit files only. Multi-pass overwrite is not reliable SSD sanitization." Foreground="#89958F" TextWrapping="Wrap"/><ComboBox x:Name="Method" SelectedIndex="0" Width="280"><ComboBoxItem Content="Simple zero-fill (1 pass)"/><ComboBoxItem Content="US DoD 5220.22-M (3 passes)"/><ComboBoxItem Content="US DoD 5220.22-M ECE (7 passes)"/><ComboBoxItem Content="Peter Gutmann (35 passes)"/><ComboBoxItem Content="Custom (1–35 passes)"/></ComboBox><CheckBox x:Name="SsdAcknowledged" Content="I understand SSD overwriting is not guaranteed"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ChooseButton" Content="Choose files" Click="Choose_Click" Background="#286E58" Foreground="White" Padding="18,10"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="18,10"/></StackPanel><ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed"/><ListView x:Name="FileList" MaxHeight="220"/><TextBlock x:Name="StatusText" Foreground="#6E8178" TextWrapping="Wrap"/></StackPanel></Page>
