<Page x:Class="CleanMachine.Windows.SecureDeletePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE7C3;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Secure Delete" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Overwrite and permanently delete files you explicitly choose. Multi-pass overwrite is not reliable sanitization on SSDs - use device encryption for sensitive data."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
          <TextBlock Text="OPTIONS" FontSize="10" Foreground="#7F9189"/>
          <ComboBox x:Name="Method" Header="Wipe method" SelectedIndex="0" Width="300" HorizontalAlignment="Left">
            <ComboBoxItem Content="Simple zero-fill (1 pass)"/>
            <ComboBoxItem Content="US DoD 5220.22-M (3 passes)"/>
            <ComboBoxItem Content="US DoD 5220.22-M ECE (7 passes)"/>
            <ComboBoxItem Content="Peter Gutmann (35 passes)"/>
            <ComboBoxItem Content="Custom (1-35 passes)"/>
          </ComboBox>
          <CheckBox x:Name="SsdAcknowledged" Content="I understand SSD overwriting is not guaranteed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="FILES" FontSize="10" Foreground="#7F9189" Margin="0,4,0,0"/>
        <ListView Grid.Row="2" x:Name="FileList"/>

        <StackPanel Grid.Row="3" Spacing="6">
          <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Text="Choose files to overwrite and delete." Foreground="#6E8178" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="18,10"/>
      <Button x:Name="ChooseButton" Content="Choose Files" Click="Choose_Click"
              Background="#286E58" Foreground="White" Padding="18,10"/>
    </StackPanel>
  </Grid>
</Page>
