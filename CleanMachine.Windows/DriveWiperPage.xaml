<Page x:Class="CleanMachine.Windows.DriveWiperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xEDA2;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Drive Wiper" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Overwrite the free space of a drive so previously deleted files become unrecoverable. Existing files are never touched; the space is free again when the wipe completes."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Top">
      <StackPanel Spacing="12">
        <TextBlock Text="OPTIONS" FontSize="10" Foreground="#7F9189"/>
        <ComboBox x:Name="DriveCombo" Header="Drive" MinWidth="360" HorizontalAlignment="Left" SelectionChanged="Drive_Changed"/>
        <ComboBox x:Name="PassesCombo" Header="Passes" MinWidth="360" HorizontalAlignment="Left" SelectedIndex="0">
          <ComboBoxItem Content="1 pass (random + zero) - fast"/>
          <ComboBoxItem Content="3 passes - thorough"/>
          <ComboBoxItem Content="7 passes - maximum"/>
        </ComboBox>
        <CheckBox x:Name="WipeMftCheck" Content="Also wipe MFT free space (NTFS)" IsChecked="True"/>
        <CheckBox x:Name="WipeFatCheck" Content="Also wipe FAT free space (FAT/exFAT)" IsChecked="True"/>
        <TextBlock x:Name="MetadataHint"
                   Text="Also overwrites the filesystem's own free metadata (NTFS MFT records, or FAT directory entries) where small deleted files can linger. Only the option matching the selected drive's filesystem applies."
                   Foreground="#89958F" FontSize="11" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
        <TextBlock Text="SSD note: due to wear levelling, overwriting free space cannot guarantee sanitization on solid-state drives. For sensitive data use device encryption; wiping free space is most useful for traditional hard drives."
                   Foreground="#C7775D" FontSize="11" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,4,0,0"/>
        <TextBlock x:Name="StatusText" Text="Select a drive and the number of passes."
                   Foreground="#6E8178" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="18,10"/>
      <Button x:Name="WipeButton" Content="Wipe Free Space" Click="Wipe_Click"
              Background="#286E58" Foreground="White" Padding="18,10"/>
    </StackPanel>
  </Grid>
</Page>
