<UserControl x:Class="CleanMachine.Windows.MetricCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#9AA7A1" FontSize="9"/><TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#374740" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="{Binding Detail, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#53A77F" FontSize="10"/></StackPanel></Border></UserControl>
