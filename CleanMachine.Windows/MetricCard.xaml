<UserControl x:Class="CleanMachine.Windows.MetricCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="{x:Bind Label, Mode=OneWay}" Foreground="#9AA7A1" FontSize="9"/><TextBlock Text="{x:Bind Value, Mode=OneWay}" Foreground="#374740" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="{x:Bind Detail, Mode=OneWay}" Foreground="#53A77F" FontSize="10"/></StackPanel></Border></UserControl>
