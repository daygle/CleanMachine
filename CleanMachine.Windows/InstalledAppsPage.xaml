<Page x:Class="CleanMachine.Windows.InstalledAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE7B8;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Installed Applications" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="View the applications installed on this machine. Uninstall launches the vendor's own installer."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Filter + summary -->
    <Border Grid.Row="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16,12">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search by name, publisher, or version..."
                        MinHeight="34" VerticalAlignment="Center"
                        TextChanged="SearchBox_TextChanged">
          <AutoSuggestBox.QueryIcon>
            <SymbolIcon Symbol="Find"/>
          </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Sort" FontSize="12" Foreground="#6E8178" VerticalAlignment="Center"/>
          <ComboBox x:Name="SortBox" MinWidth="150" VerticalAlignment="Center"
                    SelectionChanged="SortBox_SelectionChanged"
                    ToolTipService.ToolTip="Choose how the application list is ordered">
            <ComboBoxItem Content="Publisher" IsSelected="True"/>
            <ComboBoxItem Content="Name (A-Z)"/>
            <ComboBoxItem Content="Size (largest first)"/>
            <ComboBoxItem Content="Recently installed"/>
          </ComboBox>
        </StackPanel>
        <TextBlock x:Name="EntryCount" Grid.Column="2" Text="0 apps"
                   FontSize="13" Foreground="#6E8178" VerticalAlignment="Center" Margin="4,0"/>
        <Button Grid.Column="3" Content="Scan" x:Name="ScanButton" Click="Scan_Click"
                Background="#286E58" Foreground="White" Padding="20,8"/>
      </Grid>
    </Border>

    <!-- App list -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="ListLabel" Text="APPLICATIONS" FontSize="10"
                   Foreground="#7F9189" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="AppListPanel" Spacing="0"/>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Visibility="Visible">
          <FontIcon Glyph="&#xE7B8;" FontSize="32" Foreground="#D0DBD5" HorizontalAlignment="Center"/>
          <TextBlock Text="Click Scan to enumerate installed applications"
                     FontSize="13" Foreground="#9AA6A1" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer info -->
    <TextBlock Grid.Row="3" x:Name="FooterText" Text=""
               FontSize="11" Foreground="#9AA6A1" TextWrapping="Wrap"/>
  </Grid>
</Page>
