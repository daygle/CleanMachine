<Page x:Class="CleanMachine.Windows.InstalledAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE71D;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Installed Apps" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="View the applications installed on this machine. Uninstall and Modify launch the vendor's own installer - CleanMachine never deletes another program's files itself."
                 Foreground="#89958F" TextWrapping="Wrap"/>
    </StackPanel>

    <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Search by name, publisher, or version…"
             Header="FILTER" MaxWidth="420" HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged"/>

    <!-- Row 2 fills the remaining page height. -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="APPLICATIONS" FontSize="10" Foreground="#7F9189" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="AppsPanel" Spacing="2"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="18,10"/>
      <TextBlock x:Name="StatusText" Foreground="#6E8178" TextWrapping="Wrap"
                 Margin="14,0" VerticalAlignment="Center"
                 HorizontalAlignment="Left" MaxWidth="640"/>
    </Grid>
  </Grid>
</Page>
