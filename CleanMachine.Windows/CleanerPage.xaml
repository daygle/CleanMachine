<Page x:Class="CleanMachine.Windows.CleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <FontIcon Glyph="&#xE72C;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
      <TextBlock Text="Browser Cleaner" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Text="Tick what to clear for each installed browser. Destructive items — cookies, history, saved passwords — are off by default. Close the browser before cleaning."
               TextWrapping="Wrap" Foreground="#89958F"/>

    <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="ScanButton" Content="Scan browsers" Click="Scan_Click"
                  Background="#286E58" Foreground="White" Padding="18,10"/>
          <Button x:Name="CleanButton" Content="Clean selected" Click="Clean_Click"
                  Padding="18,10" IsEnabled="False"/>
        </StackPanel>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" IsIndeterminate="True" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Text="Click Scan browsers to detect installed browsers and measure what can be cleaned."
                   TextWrapping="Wrap" Foreground="#6E8178" FontSize="12"/>
        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="BrowserPanel" Spacing="10"/>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </StackPanel>
</Page>
