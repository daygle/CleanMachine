<Page x:Class="CleanMachine.Windows.CleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <FontIcon Glyph="&#xE72C;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
      <TextBlock Text="Browser Cleaner" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="Tick what to clear for each installed browser. Destructive items - cookies, history, saved passwords - are off by default. Close the browser before cleaning."
               TextWrapping="Wrap" Foreground="#89958F"/>

    <!-- Two-pane cleaning area: browser list on the left, detail on the right. -->
    <Grid Grid.Row="2" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="BROWSERS" FontSize="10" Foreground="#7F9189" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BrowserPanel" Spacing="2"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="#E2F3E9" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="#398A6D"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailHeadline" Text="Browser details"
                           FontSize="17" FontWeight="SemiBold" Foreground="#273630"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border x:Name="DetailGroupBadge" Grid.Column="1" Background="#EAF4EE" CornerRadius="5" Padding="7,3"
                        VerticalAlignment="Center" Visibility="Collapsed">
                  <TextBlock x:Name="DetailGroupBadgeText" Text="BROWSER" FontSize="9"
                             FontWeight="SemiBold" Foreground="#4B7769" CharacterSpacing="40"/>
                </Border>
              </Grid>
              <TextBlock x:Name="DetailSubHeadline" Text="Scan, then pick a browser to review what can be cleared."
                         FontSize="11" Foreground="#89958F" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="DetailBackButton" Grid.Column="2" Click="DetailBack_Click"
                    Style="{ThemeResource AccentButtonStyle}" Padding="8,4" FontSize="12"
                    Visibility="Collapsed" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                <TextBlock Text="Back"/>
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Border Background="#F2F7F4" CornerRadius="7" Padding="12,7">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="#6ABD97" VerticalAlignment="Center"/>
                  <TextBlock Text="TO CLEAN" FontSize="9" Foreground="#7F9189" CharacterSpacing="60"/>
                </StackPanel>
                <TextBlock x:Name="ChipSizeValue" Text="&#x2014;" FontSize="13" FontWeight="SemiBold" Foreground="#273630"/>
              </StackPanel>
            </Border>
            <Border Background="#F2F7F4" CornerRadius="7" Padding="12,7">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="#5B99AD" VerticalAlignment="Center"/>
                  <TextBlock Text="FILES" FontSize="9" Foreground="#7F9189" CharacterSpacing="60"/>
                </StackPanel>
                <TextBlock x:Name="ChipFilesValue" Text="&#x2014;" FontSize="13" FontWeight="SemiBold" Foreground="#273630"/>
              </StackPanel>
            </Border>
            <Border Background="#F2F7F4" CornerRadius="7" Padding="12,7">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="#C7775D" VerticalAlignment="Center"/>
                  <TextBlock Text="ITEMS" FontSize="9" Foreground="#7F9189" CharacterSpacing="60"/>
                </StackPanel>
                <TextBlock x:Name="ChipItemsValue" Text="&#x2014;" FontSize="13" FontWeight="SemiBold" Foreground="#273630"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock Grid.Row="2" x:Name="StatusText" Text="Click Scan Browsers to detect installed browsers and measure what can be cleaned."
                     FontSize="12" Foreground="#6E8178" TextWrapping="Wrap"/>
          <ProgressBar Grid.Row="3" x:Name="Progress" Minimum="0" Maximum="1" IsIndeterminate="True" Visibility="Collapsed"/>
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DetailPanel" Spacing="8"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
        <Button x:Name="ScanButton" Content="Scan Browsers" Click="Scan_Click"
                Background="#286E58" Foreground="White" Padding="20,10"/>
        <CheckBox x:Name="CloseBrowsersCheck" Content="Close Browsers First" VerticalAlignment="Center"
                  Checked="CloseBrowsers_Changed" Unchecked="CloseBrowsers_Changed"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <CheckBox x:Name="SecureDeleteCheck" Content="Secure Delete" VerticalAlignment="Center"/>
        <Button x:Name="CleanButton" Content="Clean Selected" Click="Clean_Click"
                Padding="18,10" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
