<Page x:Class="CleanMachine.Windows.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <!-- Full-width flat row for the link list. Needs its own template because the
         default button template draws a background that reads as a button on
         every row, which makes the list look like a stack of controls rather
         than a list of links. -->
    <Style x:Key="LinkRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#273630"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- Capped width: the page is prose and links, and a full-width card on a
         wide window stretches every line far past comfortable reading length. -->
    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left" Padding="0,0,0,24">

      <!-- Header -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE946;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="About" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Identity card -->
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <Border Width="64" Height="64" CornerRadius="16" Background="#286E58">
            <FontIcon Glyph="&#xE946;" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="CleanMachine" FontSize="22" FontWeight="SemiBold" Foreground="#273630"/>
            <TextBlock x:Name="VersionText" Text="Version -" FontSize="12" Foreground="#89958F"/>
            <TextBlock Text="A review-first cleanup companion for Windows: browser caches, Windows temp files, application leftovers, and read-only registry care."
                       FontSize="12" Foreground="#6E8178" TextWrapping="Wrap" MaxWidth="520" Margin="0,6,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Where the app keeps the user's data. Shown because uninstall promises to
           keep settings, statistics and history, and that promise is only true if
           the data lives outside the package folder. Making the resolved folder
           visible turns it from a claim into something the user can check. -->
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="#286E58" VerticalAlignment="Center"/>
            <TextBlock Text="Your data" FontSize="16" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="DataFolderStatus" Text="Settings, statistics and history are stored in:"
                     FontSize="12" Foreground="#53635B" TextWrapping="Wrap"/>
          <TextBlock x:Name="DataFolderPath" Text="-" FontSize="11" Foreground="#6E8178"
                     TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        </StackPanel>
      </Border>

      <!-- Support card. Tinted rather than white so the one card that asks for
           something is the one card that looks different. -->
      <Border Background="#F0F7F3" BorderBrush="#D5E8DE" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xEB51;" FontSize="18" Foreground="#286E58" VerticalAlignment="Center"/>
            <TextBlock Text="Support CleanMachine" FontSize="16" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="CleanMachine is free, has no ads, no telemetry, and no upsells. If it saved you time or disk space, you can chip in at GitHub Sponsors to cover the Microsoft Store developer account fee and keep development going."
                     FontSize="12" Foreground="#53635B" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Sponsor on GitHub" Tag="https://github.com/sponsors/daygle"
                    Click="OpenLink_Click" Padding="18,9" HorizontalAlignment="Left"/>
            <TextBlock Text="One-time or monthly - entirely optional."
                       FontSize="11" Foreground="#89958F" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Links -->
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="8">
        <StackPanel>
          <TextBlock Text="PROJECT" FontSize="10" Foreground="#7F9189" Margin="12,10,0,6"/>
          <Button x:Name="SponsorsRow" Style="{StaticResource LinkRow}" Tag="https://github.com/sponsors/daygle" Click="OpenLink_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xEB51;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <StackPanel Spacing="1">
                <TextBlock Text="GitHub Sponsors" FontSize="13" Foreground="#273630"/>
                <TextBlock Text="Sponsor the project" FontSize="11" Foreground="#9AA6A1"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="SourceRow" Style="{StaticResource LinkRow}" Tag="https://github.com/daygle/CleanMachine" Click="OpenLink_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE943;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Source code" FontSize="13" Foreground="#273630"/>
                <TextBlock Text="daygle/CleanMachine on GitHub - issues and pull requests welcome" FontSize="11" Foreground="#9AA6A1"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="PrivacyRow" Style="{StaticResource LinkRow}" Tag="https://github.com/daygle/CleanMachine/blob/main/PRIVACY.md" Click="OpenLink_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Privacy policy" FontSize="13" Foreground="#273630"/>
                <TextBlock Text="What CleanMachine stores, and what it never touches" FontSize="11" Foreground="#9AA6A1"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="IssueRow" Style="{StaticResource LinkRow}" Tag="https://github.com/daygle/CleanMachine/issues" Click="OpenLink_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Report a problem" FontSize="13" Foreground="#273630"/>
                <TextBlock Text="Open an issue" FontSize="11" Foreground="#9AA6A1"/>
              </StackPanel>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Footer -->
      <StackPanel Spacing="4" Margin="0,4,0,0">
        <TextBlock Text="Distributed and updated exclusively through the Microsoft Store. There is no installer, no bundled updater, and CleanMachine makes no network connections of its own - the links above open in your browser."
                   FontSize="11" Foreground="#9AA6A1" TextWrapping="Wrap"/>
        <TextBlock Text="Made on Windows." FontSize="11" Foreground="#B0BBB6"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
