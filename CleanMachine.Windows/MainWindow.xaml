<Window x:Class="CleanMachine.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMachine">
  <Grid Background="#F7F9F7">
    <Grid.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#273630"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="CornerRadius" Value="6"/>
      <!-- Minimal template: hover/press must not hijack Background, so the
           white active highlight (set in code-behind) stays stable. -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </Grid.Resources>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar: three rows so every item survives any window height -
         header (auto) / scrollable nav (*) / pinned bottom section (auto). -->
    <Border Grid.Column="0" Background="#F2F6F3" BorderBrush="#E5EBE7" BorderThickness="0,0,1,0" Padding="18,26">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: brand + section label -->
        <StackPanel Grid.Row="0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image x:Name="SidebarLogo" Width="30" Height="30" VerticalAlignment="Center"/>
            <TextBlock Text="CleanMachine" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#9AA6A1" FontSize="10" Margin="12,44,0,12"/>
        </StackPanel>

        <!-- Row 1: navigation buttons scroll when the window is short -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
          <StackPanel>
            <Button x:Name="NavOverview" Style="{StaticResource NavButton}" Click="Overview_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE80F;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Overview" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavCleaner" Style="{StaticResource NavButton}" Click="Cleaner_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Browser Cleaner" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavRegistry" Style="{StaticResource NavButton}" Click="Registry_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xEA18;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Registry Care" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavWindowsCleanup" Style="{StaticResource NavButton}" Click="WindowsCleanup_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE9D5;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Windows Cleanup" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavAppCleanup" Style="{StaticResource NavButton}" Click="AppCleanup_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7B8;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Application Cleanup" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavSecureDelete" Style="{StaticResource NavButton}" Click="SecureDeleteNav_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7C3;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Secure Delete" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavDriveWiper" Style="{StaticResource NavButton}" Click="DriveWiper_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Drive Wiper" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavStartupApps" Style="{StaticResource NavButton}" Click="StartupApps_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE9A9;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Startup Apps" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavInstalledApps" Style="{StaticResource NavButton}" Click="InstalledApps_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE71D;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Installed Apps" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavActivity" Style="{StaticResource NavButton}" Click="Activity_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE81C;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Activity" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavSchedules" Style="{StaticResource NavButton}" Click="Schedules_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE787;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Schedules" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- Row 2: always-visible bottom section (never clipped, never scrolled away) -->
        <StackPanel Grid.Row="2">
          <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="Settings_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <TextBlock Text="Settings" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavUpdates" Style="{StaticResource NavButton}" Click="CheckUpdates_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <TextBlock Text="Updates" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content: the Frame must receive a definite height (a Grid cell, not a
         StackPanel inside a ScrollViewer) so each page can stretch to the full
         window height and manage its own internal scrolling. -->
    <Grid Grid.Column="1" Margin="0,45,0,18">
      <Frame x:Name="ContentFrame" Margin="36,0,36,0"/>
    </Grid>
  </Grid>
</Window>
