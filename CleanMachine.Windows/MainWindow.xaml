<Window x:Class="CleanMachine.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CleanMachine">
<Grid Background="#F7F9F7"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#F2F6F3" BorderBrush="#E5EBE7" BorderThickness="0,0,1,0" Padding="18,26"><StackPanel>
<StackPanel Orientation="Horizontal" Spacing="10"><Image x:Name="SidebarLogo" Width="30" Height="30" VerticalAlignment="Center"/><TextBlock Text="CleanMachine" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/></StackPanel>
<TextBlock Text="WORKSPACE" Foreground="#9AA6A1" FontSize="10" Margin="12,44,0,12"/>
<Button Content="Overview" Click="Overview_Click" HorizontalContentAlignment="Left" Padding="12" Background="White" BorderThickness="0"/><Button Content="Browser Cleaner" Click="Cleaner_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/><Button Content="Registry Care" Click="Registry_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/><Button Content="Windows Cleanup" Click="WindowsCleanup_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/><Button Content="Secure Delete" Click="SecureDeleteNav_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/><Button Content="Activity" Click="Activity_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/>
<StackPanel Margin="0,196,0,0"><Border Background="#EAF4EE" BorderBrush="#DCE8E1" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock x:Name="AgentStatusText" Text="●  Background Agent  ON" Foreground="#4B675D" FontSize="11"/><TextBlock Text="Watching for browser exits" Foreground="#91A29A" FontSize="10" Margin="14,7,0,0"/></StackPanel></Border><Button Content="Settings" Click="Settings_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/><Button Content="Updates" Click="CheckUpdates_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/></StackPanel></StackPanel></Border>
<ScrollViewer Grid.Column="1"><StackPanel MaxWidth="1000" HorizontalAlignment="Center" Margin="0,45,0,0" Spacing="18"><Frame x:Name="ContentFrame" Margin="54,0,54,0"/></StackPanel></ScrollViewer></Grid></Window>
