<Window x:Class="CleanMachine.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMachine">
  <Grid Background="#F7F9F7">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar: three rows so every item survives any window height —
         header (auto) / scrollable nav (*) / pinned bottom section (auto). -->
    <Border Grid.Column="0" Background="#F2F6F3" BorderBrush="#E5EBE7" BorderThickness="0,0,1,0" Padding="18,26">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: brand + section label -->
        <StackPanel Grid.Row="0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image x:Name="SidebarLogo" Width="30" Height="30" VerticalAlignment="Center"/>
            <TextBlock Text="CleanMachine" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#9AA6A1" FontSize="10" Margin="12,44,0,12"/>
        </StackPanel>

        <!-- Row 1: navigation buttons scroll when the window is short -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
          <StackPanel>
            <Button Click="Overview_Click" HorizontalContentAlignment="Left" Padding="12" Background="White" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE80F;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Overview" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Click="Cleaner_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Browser Cleaner" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Click="Registry_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xEA18;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Registry Care" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Click="WindowsCleanup_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE9D5;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Windows Cleanup" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Click="SecureDeleteNav_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7C3;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Secure Delete" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Click="Activity_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE81C;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
                <TextBlock Text="Activity" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- Row 2: always-visible bottom section (never clipped, never scrolled away) -->
        <StackPanel Grid.Row="2">
          <Border Background="#EAF4EE" BorderBrush="#DCE8E1" BorderThickness="1" CornerRadius="9" Padding="12">
            <StackPanel>
              <TextBlock x:Name="AgentStatusText" Text="●  Background Agent  ON" Foreground="#4B675D" FontSize="11"/>
              <TextBlock Text="Watching for browser exits" Foreground="#91A29A" FontSize="10" Margin="14,7,0,0"/>
            </StackPanel>
          </Border>
          <Button Click="Settings_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <TextBlock Text="Settings" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Click="CheckUpdates_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="#4B7769" VerticalAlignment="Center"/>
              <TextBlock Text="Updates" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Column="1">
      <StackPanel MaxWidth="1000" HorizontalAlignment="Center" Margin="0,45,0,0" Spacing="18">
        <Frame x:Name="ContentFrame" Margin="54,0,54,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
