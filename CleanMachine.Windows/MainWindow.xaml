<Window
    x:Class="CleanMachine.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanMachine.Windows"
    Title="CleanMachine">
    <Grid Background="#F7F9F7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F2F6F3" BorderBrush="#E5EBE7" BorderThickness="0,0,1,0" Padding="18,26">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="30" Height="30" CornerRadius="9" Background="#BFE5D5"><TextBlock Text="✓" Foreground="#246453" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="cleanmachine" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Text="WORKSPACE" Foreground="#9AA6A1" FontSize="10" Margin="12,44,0,12"/>
                <Button Content="Overview" HorizontalContentAlignment="Left" Padding="12" Background="White" BorderThickness="0"/>
                <Button Content="Windows Cleanup" Click="WindowsCleanup_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/>
                <Button Content="Cleaner" Click="Cleaner_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/>
                <Button Content="Activity" Click="Activity_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/>
                <StackPanel VerticalAlignment="Bottom" Margin="0,320,0,0"><Border Background="#EAF4EE" BorderBrush="#DCE8E1" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock x:Name="AgentStatusText" Text="●  Background agent  ON" Foreground="#4B675D" FontSize="11"/><TextBlock Text="Watching for browser exits" Foreground="#91A29A" FontSize="10" Margin="14,7,0,0"/></StackPanel></Border><Button Content="Settings" Click="Settings_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/><Button Content="Updates" Click="CheckUpdates_Click" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/><Button Content="Help center" HorizontalContentAlignment="Left" Padding="12" Background="Transparent" BorderThickness="0"/></StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1"><StackPanel MaxWidth="1000" Margin="54,45" Spacing="18">
            <StackPanel><TextBlock x:Name="SystemStatusText" Text="●  ALL SYSTEMS CLEAR" Foreground="#6EA587" FontSize="10"/><TextBlock Text="Your privacy, handled." Foreground="#273630" FontSize="36" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="CleanMachine quietly clears your digital trail so you can browse with peace of mind." Foreground="#89958F" FontSize="13" Margin="0,10,0,0"/></StackPanel>
            <Border Background="#DCEFE5" CornerRadius="13" Padding="30"><StackPanel><TextBlock Text="READY WHEN YOU ARE" Foreground="#7F9189" FontSize="10"/><TextBlock Text="Clear the clutter. Keep the good stuff." Foreground="#254239" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Remove cached files, cookies, and history without touching saved passwords or bookmarks." Foreground="#709086" MaxWidth="430" TextWrapping="Wrap"/><Button x:Name="CleanNowButton" Content="Clean now" Click="CleanNow_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Background="#286E58" Foreground="White" Padding="18,10"/></StackPanel></Border>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><local:MetricCard Grid.Column="0" Label="SPACE RECOVERED" Value="12.8 GB" Detail="↑ 2.4 GB this week"/><local:MetricCard Grid.Column="1" Label="ITEMS REMOVED" Value="28,491" Detail="↑ 14% from last week"/><local:MetricCard Grid.Column="2" Label="LAST CLEANUP" Value="12 min ago" Detail="Everything looks fresh"/></Grid>
            <StackPanel Margin="0,20,0,0"><TextBlock Text="Protected browsers" FontSize="16" FontWeight="SemiBold" Foreground="#3A4943"/><TextBlock Text="Cleaned automatically when they close" FontSize="11" Foreground="#9AA6A1" Margin="0,5,0,12"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><local:BrowserCard Grid.Column="0" BrowserName="Google Chrome" DataSize="1.84 GB"/><local:BrowserCard Grid.Column="1" BrowserName="Microsoft Edge" DataSize="620 MB"/><local:BrowserCard Grid.Column="2" BrowserName="Mozilla Firefox" DataSize="340 MB"/></Grid></StackPanel>
            <StackPanel Margin="0,20,0,0"><TextBlock Text="Windows Cleanup" FontSize="16" FontWeight="SemiBold" Foreground="#3A4943"/><TextBlock Text="Reclaim space from safe system leftovers" FontSize="11" Foreground="#9AA6A1" Margin="0,5,0,12"/><Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><Grid><StackPanel><TextBlock Text="Scan Windows safely" FontSize="13" FontWeight="SemiBold" Foreground="#465650"/><TextBlock Text="Review reclaimable temporary files and caches before anything is removed." Foreground="#89958F" FontSize="11" TextWrapping="Wrap" MaxWidth="600" Margin="0,6,0,0"/></StackPanel><Button Content="Scan Windows" Click="WindowsCleanupScan_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E3F4EB" Foreground="#3F8E6D" BorderThickness="0" Padding="16,10"/></Grid><TextBlock Text="Safe by default: personal folders, saved passwords, restore points, drivers, and active update files are excluded." Foreground="#A0AAA6" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border></StackPanel>
            <StackPanel Margin="0,20,0,0"><TextBlock Text="Secure Delete" FontSize="16" FontWeight="SemiBold" Foreground="#3A4943"/><TextBlock Text="Optional protection for files you explicitly choose" FontSize="11" Foreground="#9AA6A1" Margin="0,5,0,12"/><Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><Grid><StackPanel><TextBlock Text="Overwrite before deleting" FontSize="13" FontWeight="SemiBold" Foreground="#465650"/><TextBlock Text="Choose a named overwrite method or configure a custom method. Multiple passes may not sanitize SSD storage." Foreground="#89958F" FontSize="11" TextWrapping="Wrap" MaxWidth="600" Margin="0,6,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><ComboBox x:Name="WipeMethodCombo" Width="205" SelectedIndex="0"><ComboBoxItem Content="Simple zero-fill (1 pass)"/><ComboBoxItem Content="US DoD 5220.22-M (3 passes)"/><ComboBoxItem Content="US DoD 5220.22-M ECE (7 passes)"/><ComboBoxItem Content="Peter Gutmann (35 passes)"/><ComboBoxItem Content="Custom (1–35 passes)"/></ComboBox><NumberBox x:Name="CustomPassesBox" Width="75" Value="1" Minimum="1" Maximum="35" SpinButtonPlacementMode="Compact" Header="Custom"/><Button Content="Enable" Click="SecureDelete_Click" Background="#E3F4EB" Foreground="#3F8E6D" BorderThickness="0" Padding="12,8"/></StackPanel></Grid><CheckBox x:Name="SsdWarningCheck" Content="I understand SSD overwriting is not guaranteed" Margin="0,14,0,0"/><TextBlock Text="Secure Delete is never used automatically, never targets folders, and skips locked or protected files." Foreground="#A0AAA6" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></StackPanel></Border></StackPanel>
            <StackPanel Margin="0,20,0,0"><TextBlock Text="Application updates" FontSize="16" FontWeight="SemiBold" Foreground="#3A4943"/><TextBlock Text="Stay current through verified CleanMachine releases" FontSize="11" Foreground="#9AA6A1" Margin="0,5,0,12"/><Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="18"><Grid><StackPanel><TextBlock Text="Secure release channel" FontSize="13" FontWeight="SemiBold" Foreground="#465650"/><TextBlock Text="Updates are downloaded from HTTPS release artifacts and verified with SHA-256 before installation." Foreground="#89958F" FontSize="11" TextWrapping="Wrap" MaxWidth="600" Margin="0,6,0,0"/></StackPanel><Button Content="Check for updates" Click="CheckUpdates_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E3F4EB" Foreground="#3F8E6D" BorderThickness="0" Padding="16,10"/></Grid></Border></StackPanel>
            <StackPanel Margin="0,20,0,0"><TextBlock Text="Registry Care" FontSize="16" FontWeight="SemiBold" Foreground="#3A4943"/><TextBlock Text="Safe, review-first maintenance for low-risk leftovers" FontSize="11" Foreground="#9AA6A1" Margin="0,5,0,12"/><Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><Grid><StackPanel><TextBlock Text="Scan before you change anything" FontSize="13" FontWeight="SemiBold" Foreground="#465650"/><TextBlock Text="Only approved user-level locations are inspected. Nothing is changed until you review it." Foreground="#89958F" FontSize="11" TextWrapping="Wrap" MaxWidth="600" Margin="0,6,0,0"/></StackPanel><Button Content="Safe scan" Click="RegistryScan_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E3F4EB" Foreground="#3F8E6D" BorderThickness="0" Padding="16,10"/></Grid><Border Background="#F7FAF8" CornerRadius="8" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="SAFE CLEANING OPTIONS" Foreground="#7F9189" FontSize="9"/><CheckBox Content="Orphaned uninstall metadata" IsChecked="True" Margin="0,10,0,0"/><CheckBox Content="Broken user-level file associations" IsChecked="True"/><CheckBox Content="Startup entries with missing targets" IsChecked="False"/><TextBlock Text="System services, drivers, COM registrations, and security entries are never auto-cleaned." Foreground="#A0AAA6" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></Border></StackPanel>
        </StackPanel></ScrollViewer>
    </Grid>
</Window>
