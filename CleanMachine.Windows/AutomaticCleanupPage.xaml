<Page x:Class="CleanMachine.Windows.AutomaticCleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE9F5;" FontSize="24" Foreground="#286E58" VerticalAlignment="Center"/>
        <TextBlock Text="Automatic Cleanup" FontSize="30" FontWeight="SemiBold" Foreground="#273630" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Let CleanMachine clean on its own - when browsers close, when free space runs low, at startup, while the PC is idle, and by keeping the Recycle Bin tidy. Each trigger below has its own on/off switch and its own choice of what to clean. Automatic runs only ever touch cleanup categories, never the Review or Advanced ones from Windows Cleanup."
                 TextWrapping="Wrap" Foreground="#89958F"/>

      <!-- Browser close -->
      <TextBlock Text="WHEN A BROWSER CLOSES" FontSize="10" Foreground="#7F9189" Margin="0,4,0,0"/>
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="10">
          <CheckBox x:Name="CleanToggle" Content="Clean up when a supported browser closes"
                    FontSize="13" Checked="CleanToggle_Changed" Unchecked="CleanToggle_Changed"/>
          <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid MinWidth="460">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Browser" FontSize="11" Foreground="#7F9189" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="After Closing" FontSize="11" Foreground="#7F9189" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Items Cleaned" FontSize="11" Foreground="#7F9189" Margin="0,0,0,6"/>
              <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ChromeEnabled" Content="Google Chrome" Margin="0,4,0,4"
                        Checked="BrowserMonitor_Changed" Unchecked="BrowserMonitor_Changed"/>
              <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ChromeAction" SelectedIndex="2" Margin="0,4,0,4"
                        SelectionChanged="BrowserMonitor_Changed">
                <ComboBoxItem Content="Do nothing"/>
                <ComboBoxItem Content="Clean silently"/>
                <ComboBoxItem Content="Clean and notify"/>
              </ComboBox>
              <Button Grid.Row="1" Grid.Column="2" x:Name="ChromeItemsButton" Tag="chrome" Click="ChooseExitItems_Click"
                      Padding="14,8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <CheckBox Grid.Row="2" Grid.Column="0" x:Name="EdgeEnabled" Content="Microsoft Edge" Margin="0,4,0,4"
                        Checked="BrowserMonitor_Changed" Unchecked="BrowserMonitor_Changed"/>
              <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EdgeAction" SelectedIndex="2" Margin="0,4,0,4"
                        SelectionChanged="BrowserMonitor_Changed">
                <ComboBoxItem Content="Do nothing"/>
                <ComboBoxItem Content="Clean silently"/>
                <ComboBoxItem Content="Clean and notify"/>
              </ComboBox>
              <Button Grid.Row="2" Grid.Column="2" x:Name="EdgeItemsButton" Tag="edge" Click="ChooseExitItems_Click"
                      Padding="14,8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <CheckBox Grid.Row="3" Grid.Column="0" x:Name="FirefoxEnabled" Content="Firefox" Margin="0,4,0,4"
                        Checked="BrowserMonitor_Changed" Unchecked="BrowserMonitor_Changed"/>
              <ComboBox Grid.Row="3" Grid.Column="1" x:Name="FirefoxAction" SelectedIndex="2" Margin="0,4,0,4"
                        SelectionChanged="BrowserMonitor_Changed">
                <ComboBoxItem Content="Do nothing"/>
                <ComboBoxItem Content="Clean silently"/>
                <ComboBoxItem Content="Clean and notify"/>
              </ComboBox>
              <Button Grid.Row="3" Grid.Column="2" x:Name="FirefoxItemsButton" Tag="firefox" Click="ChooseExitItems_Click"
                      Padding="14,8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Grid>
          </Border>
          <TextBlock x:Name="MonitoringHint"
                     FontSize="11" Foreground="#709086" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Low disk space -->
      <TextBlock Text="WHEN FREE DISK SPACE IS LOW" FontSize="10" Foreground="#7F9189" Margin="0,4,0,0"/>
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <CheckBox x:Name="SystemMonitoringToggle" Content="Clean up when free disk space drops below"
                    Checked="Setting_Changed" Unchecked="Setting_Changed"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <NumberBox x:Name="FreeSpaceBox" Value="1" Minimum="0.1" Maximum="100" SpinButtonPlacementMode="Inline"
                       SmallChange="0.1" LargeChange="1" Width="120" ValueChanged="FreeSpace_ValueChanged"/>
            <ComboBox x:Name="FreeSpaceUnit" Width="80" VerticalAlignment="Center" SelectionChanged="FreeSpaceUnit_Changed">
              <ComboBoxItem Content="GB"/>
              <ComboBoxItem Content="MB"/>
            </ComboBox>
            <TextBlock Text="on the Windows drive" VerticalAlignment="Center" Foreground="#53635B"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <TextBlock Text="Then:" VerticalAlignment="Center" Foreground="#53635B"/>
            <ComboBox x:Name="SystemMonitorAction" SelectedIndex="1" Width="220" SelectionChanged="Setting_ComboChanged">
              <ComboBoxItem Content="Do nothing"/>
              <ComboBoxItem Content="Clean silently"/>
              <ComboBoxItem Content="Clean and notify"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <Button Content="Choose items..." Click="ChooseMonitorItems_Click" Padding="14,8"/>
            <TextBlock x:Name="MonitorItemsSummary" VerticalAlignment="Center" FontSize="11" Foreground="#89958F"/>
          </StackPanel>
          <TextBlock Text="Runs at most once per hour and waits until space recovers before triggering again."
                     FontSize="11" Foreground="#89958F" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- At startup -->
      <TextBlock Text="AT STARTUP" FontSize="10" Foreground="#7F9189" Margin="0,4,0,0"/>
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <CheckBox x:Name="StartupCleanToggle" Content="Clean up when CleanMachine starts"
                    Checked="Setting_Changed" Unchecked="Setting_Changed"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <Button Content="Choose items..." Click="ChooseStartupItems_Click" Padding="14,8"/>
            <TextBlock x:Name="StartupItemsSummary" VerticalAlignment="Center" FontSize="11" Foreground="#89958F"/>
          </StackPanel>
          <TextBlock Text="With 'Start CleanMachine when I sign in to Windows' (Settings), this runs once at every logon."
                     FontSize="11" Foreground="#89958F" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- When idle -->
      <TextBlock Text="WHEN THE PC IS IDLE" FontSize="10" Foreground="#7F9189" Margin="0,4,0,0"/>
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <CheckBox x:Name="IdleCleanToggle" Content="Clean up after the PC has been idle"
                    Checked="Setting_Changed" Unchecked="Setting_Changed"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <NumberBox x:Name="IdleMinutesBox" Value="15" Minimum="1" Maximum="240" SpinButtonPlacementMode="Inline"
                       SmallChange="1" LargeChange="15" Width="120" ValueChanged="IdleMinutes_ValueChanged"/>
            <TextBlock Text="minutes of inactivity" VerticalAlignment="Center" Foreground="#53635B"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <Button Content="Choose items..." Click="ChooseIdleItems_Click" Padding="14,8"/>
            <TextBlock x:Name="IdleItemsSummary" VerticalAlignment="Center" FontSize="11" Foreground="#89958F"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Recycle Bin -->
      <TextBlock Text="RECYCLE BIN" FontSize="10" Foreground="#7F9189" Margin="0,4,0,0"/>
      <Border Background="White" BorderBrush="#E5EBE7" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="12">
          <CheckBox x:Name="RecycleBinToggle" Content="Automatically empty Recycle Bin items older than"
                    Checked="Setting_Changed" Unchecked="Setting_Changed"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <NumberBox x:Name="RecycleBinDaysBox" Value="30" Minimum="1" Maximum="365" SpinButtonPlacementMode="Inline"
                       SmallChange="1" LargeChange="7" Width="120" ValueChanged="RecycleBinDays_ValueChanged"/>
            <TextBlock Text="days" VerticalAlignment="Center" Foreground="#53635B"/>
          </StackPanel>
          <TextBlock Text="Only removes items that are already in the Recycle Bin."
                     FontSize="11" Foreground="#89958F" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Foreground="#6E8178" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</Page>
